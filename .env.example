# ─── Supabase ─────────────────────────────────────────────────────────────────
# Found in: Supabase dashboard → Project Settings → API

# Public URL of your Supabase project (safe to expose in client code)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key — enforces Row Level Security (safe to expose)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — bypasses RLS, NEVER expose to the client
# Used only in server-side route handlers (/api/export-pdf)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Anthropic ────────────────────────────────────────────────────────────────
# Found in: https://console.anthropic.com → API Keys
# Used only server-side (/api/ai-apu) — never sent to the browser
ANTHROPIC_API_KEY=sk-ant-api03-...

# ─── App ──────────────────────────────────────────────────────────────────────
# Full public URL of the deployed app (no trailing slash)
# Local:      http://localhost:3000
# Production: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
